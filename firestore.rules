rules_version = '2';

/**
 * Reglas de QuéVeo.
 *
 * La idea: cada quien manda sobre sus cosas, y un amigo aceptado puede *leer*
 * tus calificaciones, nunca escribirlas. Las listas en conjunto son de quienes
 * están dentro.
 *
 * Para publicarlas:  npx firebase deploy --only firestore:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    // El id de una amistad es siempre el mismo par ordenado
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function friendship(other) {
      return get(/databases/$(database)/documents/friendships/$(pairId(me(), other)));
    }

    function isFriendOf(other) {
      return signedIn()
        && exists(/databases/$(database)/documents/friendships/$(pairId(me(), other)))
        && friendship(other).data.status == 'accepted';
    }

    // Nombre y foto: los ve cualquiera que ya tenga tu id (por código o por ser tu amigo).
    // Nadie puede pedir "dame todos los perfiles": solo se consulta de uno en uno.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if signedIn() && me() == uid;
    }

    // El directorio de códigos: solo se puede consultar el código exacto que te pasaron.
    // Nadie puede sobrescribir un código ajeno porque escribir sobre un documento
    // que ya existe cuenta como update, y eso está cerrado.
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if signedIn() && resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /users/{uid} {
      // El perfil interno (tu foto propia) es solo tuyo
      allow read, write: if signedIn() && me() == uid;

      // Tus calificaciones: tuyas para escribir, de tus amigos para leer
      match /items/{itemId} {
        allow read: if signedIn() && (me() == uid || isFriendOf(uid));
        allow write: if signedIn() && me() == uid;
      }

      // Lo que un amigo te recomienda. Él puede dejarla, tú leerla y quitarla.
      match /recs/{itemId} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn()
          && isFriendOf(uid)
          && request.resource.data.from.uid == me();
      }
    }

    // Amistades: un documento por par, con los dos uids dentro
    match /friendships/{pair} {
      // Preguntar por una amistad que todavía no existe es parte del flujo normal
      // (antes de invitar), así que no puede tronar
      allow read: if signedIn() && (resource == null || me() in resource.data.members);

      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && request.resource.data.requestedBy == me()
        && request.resource.data.status == 'pending'
        && pair == pairId(request.resource.data.members[0], request.resource.data.members[1]);

      // Lo único que se puede cambiar es aceptar una invitación pendiente, y solo
      // lo hace quien la recibió. Para cualquier otra cosa se borra y se vuelve a
      // invitar; así nadie puede regresar a "pendiente" una amistad ya hecha.
      allow update: if signedIn()
        && me() in resource.data.members
        && resource.data.status == 'pending'
        && resource.data.requestedBy != me()
        && request.resource.data.status == 'accepted'
        && request.resource.data.members == resource.data.members
        && request.resource.data.requestedBy == resource.data.requestedBy;

      allow delete: if signedIn() && me() in resource.data.members;
    }

    // Listas en conjunto: de quienes están dentro
    match /lists/{listId} {
      function members() {
        return get(/databases/$(database)/documents/lists/$(listId)).data.members;
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Desde dentro se puede invitar a más gente (sin sacar a nadie) y cambiar
      // nombre, emoji, color o el link. Quién la creó y cuándo no se tocan.
      function memberUpdate() {
        return me() in resource.data.members
          && me() in request.resource.data.members
          && request.resource.data.members.toSet().hasAll(resource.data.members.toSet())
          && changed().hasOnly(['members', 'profiles', 'name', 'emoji', 'color', 'inviteToken']);
      }

      // Salirse uno mismo, y nada más: así nadie se queda con la lista corriendo a los demás
      function leave() {
        return me() in resource.data.members
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([me()].toSet())
          && changed().hasOnly(['members']);
      }

      // Entrar con un link: hay que traer el token de una invitación de esta lista,
      // y solo puedes agregarte a ti (con tu nombre y tu foto). El token va en tu
      // propia llave de `joins`: si fuera un campo común, quedaría guardado tras el
      // primero que entra y cualquiera podría pasar sin traerlo.
      function joinWithLink() {
        let token = request.resource.data.joins[me()];
        let invite = /databases/$(database)/documents/listInvites/$(token);
        return !(me() in resource.data.members)
          && request.resource.data.joins.diff(resource.data.get('joins', {})).affectedKeys().hasOnly([me()])
          && token is string
          && exists(invite)
          && get(invite).data.listId == listId
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([me()].toSet())
          && changed().hasOnly(['members', 'profiles', 'joins'])
          && request.resource.data.profiles.diff(resource.data.get('profiles', {})).affectedKeys().hasOnly([me()]);
      }

      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && me() in request.resource.data.members
        && request.resource.data.createdBy == me();
      allow update: if signedIn() && (memberUpdate() || leave() || joinWithLink());
      // Solo la borra el último que queda: nadie le tumba la lista a los demás
      allow delete: if signedIn() && resource.data.members == [me()];

      match /items/{itemId} {
        // Las palomitas y los votos son de cada quien: solo tocas tu propia llave
        function onlyMine(field) {
          return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([me()]);
        }

        function itemUpdate() {
          let keys = request.resource.data.diff(resource.data).affectedKeys();
          return keys.hasOnly(['watchedBy', 'votes', 'removedAt', 'removedBy', 'addedBy', 'addedAt', 'watched', 'watchedAt'])
            && (!keys.hasAny(['watchedBy']) || onlyMine('watchedBy'))
            && (!keys.hasAny(['votes']) || onlyMine('votes'))
            && (!keys.hasAny(['addedBy']) || request.resource.data.addedBy.uid == me())
            && (!keys.hasAny(['removedBy']) || request.resource.data.removedBy == null || request.resource.data.removedBy.uid == me())
            // La palomita vieja (una para todos) solo se puede quitar, para pasar a la nueva
            && (!keys.hasAny(['watched']) || request.resource.data.get('watched', false) == false);
        }

        allow read, delete: if signedIn() && me() in members();
        allow create: if signedIn() && me() in members() && request.resource.data.addedBy.uid == me();
        allow update: if signedIn() && me() in members() && itemUpdate();
      }
    }

    // Links de invitación a una lista. Como los códigos de usuario: solo se consulta
    // el token exacto que te pasaron, nunca "todos". El token es la llave.
    match /listInvites/{token} {
      function listOf(listId) {
        return get(/databases/$(database)/documents/lists/$(listId)).data;
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.by.uid == me()
        && me() in listOf(request.resource.data.listId).members;
      allow update: if signedIn()
        && me() in listOf(resource.data.listId).members
        && request.resource.data.listId == resource.data.listId;
      allow delete: if signedIn() && me() in listOf(resource.data.listId).members;
    }
  }
}
